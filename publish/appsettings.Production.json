{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "System": "Warning"
    }
  },

  "Security": {
    "RequireHttps": true,
    "EnableHsts": true,
    "HstsMaxAgeDays": 365,
    "CookieSecurePolicy": "Always",
    "HttpsPort": 443,
    "Notes": "Production environment - HTTPS REQUIRED"
  },

  "AllowedHosts": "*"
}
